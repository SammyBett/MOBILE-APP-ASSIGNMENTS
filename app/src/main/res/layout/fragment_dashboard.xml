<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tenantCountTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Tenants: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#E8EEF7"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/totalRentTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Rent: KSh 0.0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#E8EEF7"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/addTenantButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Tenant"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/viewTenantsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Tenants" />

</LinearLayout>
